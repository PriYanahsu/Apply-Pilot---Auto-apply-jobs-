{
  "name": "applypilot",
  "description": "Finds fresh Naukri jobs that match your resume and applies to them, all inside your own Chrome.",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "postinstall": "npm run copy-pdf-worker && wxt prepare",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "copy-pdf-worker": "node -e \"require('fs').copyFileSync('node_modules/pdfjs-dist/build/pdf.worker.min.mjs','public/pdf.worker.min.js')\"",
    "predev": "npm run copy-pdf-worker",
    "prebuild": "npm run copy-pdf-worker"
  },
  "dependencies": {
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.4.0",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/chrome": "^0.3.4",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@wxt-dev/module-react": "^1.2.2",
    "jsdom": "^25.0.1",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.6.3",
    "vitest": "^3.2.4",
    "wxt": "^0.21.4"
  },
  "overrides": {
    "@vitejs/plugin-react": "5.1.0"
  }
}
